<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Event_Duration_F__c</fullName>
    <description>Event duration (in minutes)</description>
    <externalId>false</externalId>
    <formula>IF(
  OR(ISNULL(Event_Start_DateTime_F__c), ISNULL(Event_End_Datetime_F__c)),
  0,
  (Event_End_Datetime_F__c - Event_Start_DateTime_F__c) * 24 * 60
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Event Duration (Minutes)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
